#!/bin/sh
# A Git pre-commit hook: stop a commit that would add a file with a credential in it.
#
# To use it in a repository, a PERSON copies this file to .git/hooks/pre-commit and makes it executable. The agent
# does not: .git/ is Git's own folder, and under the zone rules the agent writes nothing there.
#
# WHAT IT SCANS: the staged copy of every file the commit would add or change, a renamed file included. Not the file
# on disk, which may have been changed again after `git add`. The staged copies are written to a temporary folder,
# scanned there, and the folder is removed. So the places it reports begin with that folder's name.
# A staged link to another repository (a submodule) has no content here and is not scanned.
#
# It runs two scans:
#   1. the program's own scanner, tools/secret_scan.py, unchanged;
#   2. the second pattern in participant/tools/use_credential.py.
# If either finds something, it prints where, never the value, and exits with 1. Git then makes no commit.
#
# IF A SCAN CANNOT BE RUN AT ALL (the project's Python is missing, GTQ_HOME is wrong, the staged files could not be
# written out), the commit is also stopped, and the message says that the scan did not run. It does not say a
# credential was found, because none was looked for.
#
# GTQ_HOME is the Golden Thread Quest repository that holds the two scanners. If it is not set, it is the repository
# the commit is being made in.
#
# WHAT IT DOES NOT DO
#   It does not run when a person commits with --no-verify, which skips every hook.
#   Git does not run it for a merge that completes by itself, a rebase, a cherry-pick or `git am`.
#   It sees the shapes the two scanners know. A credential of another shape passes.
#   It looks at what this commit adds or changes. It does not look at what is already in the history.

home="${GTQ_HOME:-$(git rev-parse --show-toplevel)}"
could_not_run() {
    echo "pre-commit: COMMIT STOPPED. The secret scan could not be run: $1" >&2
    echo "pre-commit: no file was scanned, so nothing is known about this commit. Put the scan right and commit again." >&2
    exit 1
}

[ -x "$home/.venv/bin/python" ] || could_not_run "there is no Python at $home/.venv/bin/python"
[ -f "$home/tools/secret_scan.py" ] || could_not_run "there is no scanner at $home/tools/secret_scan.py"
[ -f "$home/participant/tools/use_credential.py" ] || could_not_run "the second pattern is not at $home/participant/tools/use_credential.py"

tmp="${TMPDIR:-/tmp}"
work=$(mktemp -d "${tmp%/}/gtq-pre-commit.XXXXXX") || could_not_run "a temporary folder could not be made"
trap 'rm -rf "$work"' EXIT
staged="$work/staged"

# Every staged file that is not a deletion. --no-renames: a renamed file is listed as a new one, so it is scanned.
# -z: names are passed whole, whatever characters they hold. The list goes to a file so that a failure of git is seen.
git diff --cached --name-only --no-renames --diff-filter=d -z > "$work/list" || could_not_run "git could not list the staged files"
[ -s "$work/list" ] || exit 0
git checkout-index --prefix="$staged/" -z --stdin < "$work/list" || could_not_run "the staged files could not be written out"
[ -d "$staged" ] || could_not_run "the staged files were not written out"

status=0
# The program's scanner takes files, not a folder: given a folder it scans nothing and passes. So it is given every file.
"$home/.venv/bin/python" -c '
import os, subprocess, sys
files = sorted(os.path.join(d, n) for d, _, names in os.walk(sys.argv[2]) for n in names)
if not files:
    sys.exit(4)
try:
    sys.exit(subprocess.call([sys.executable, sys.argv[1], "--"] + files))
except OSError:
    sys.exit(3)
' "$home/tools/secret_scan.py" "$staged"
first=$?
python3 "$home/participant/tools/use_credential.py" scan "$staged"
second=$?

[ "$first" -eq 0 ] || [ "$first" -eq 1 ] || could_not_run "the program's scanner ended with status $first"
[ "$second" -eq 0 ] || [ "$second" -eq 1 ] || could_not_run "the second pattern ended with status $second"
[ "$first" -eq 1 ] && status=1
[ "$second" -eq 1 ] && status=1

if [ "$status" -ne 0 ]; then
    echo "pre-commit: COMMIT BLOCKED. A staged file holds what looks like a credential. Nothing was committed." >&2
    echo "pre-commit: take the value out of the file and add it again. If it was a real credential, it has been on this disk: rotate it." >&2
fi
exit "$status"
